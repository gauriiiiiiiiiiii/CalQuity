# Copy to .env and fill in. .env is gitignored.
# The agent uses any OpenAI-compatible endpoint. Provider and model are auto-detected
# from the key prefix, so usually you only need the key:
#   gsk_...  -> Groq      (https://api.groq.com/openai/v1, openai/gpt-oss-120b)
#   xai-...  -> xAI Grok  (https://api.x.ai/v1, grok-4)
LLM_API_KEY=

# Optional explicit overrides:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
