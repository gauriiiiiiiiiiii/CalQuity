# Copy to .env and fill in. .env is gitignored.
# The agent uses any OpenAI-compatible endpoint. Provider + model are auto-detected
# from the key prefix, so you usually only need the key:
#   gsk_...  -> Groq      (https://api.groq.com/openai/v1, llama-3.3-70b-versatile)
#   xai-...  -> xAI Grok  (https://api.x.ai/v1, grok-4)
LLM_API_KEY=

# Optional explicit overrides:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
